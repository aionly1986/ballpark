# Copy to .env.local and fill in. Never commit real values.

# Neon (Postgres) connection string — used by the lead-capture API route.
# Get this from your Neon project dashboard (use the pooled/serverless URL).
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Where new-lead notifications are sent. Operator to supply the mechanism
# (email address, webhook URL, etc.). Read by the API route.
LEAD_NOTIFY_EMAIL="operator@example.com"

# Public site URL, used for canonical tags and the sitemap.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
